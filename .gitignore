# Python compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment / secrets — NEVER commit these
.env
*.env
.env.local
.env.production

# Generated scan outputs and runtime logs
# reports/ holds PDF deliverables only — no HTML, no JSON
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep
logs/scan_state/

# Test, lint and coverage caches
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Packaging / build output
build/
dist/
*.egg-info/

# Developer test utilities
test_scan.py

# IDE and OS metadata
.DS_Store
Thumbs.db
*.swp
*.bak
.vscode/
.idea/

# Node tooling for the dashboard tests
node_modules/
