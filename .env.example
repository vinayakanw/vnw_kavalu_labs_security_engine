# Kavalu Security Engine — example environment configuration.
#
# Every variable is OPTIONAL. The engine runs with none of them set.
#
# NOTE: the application does NOT read this file automatically (there is no
# python-dotenv). Load it yourself, for example:
#     set -a; source .env; set +a; python app.py
#     docker run --env-file .env -p 10000:10000 kavalu-security-engine
# Copy to `.env` (git-ignored) and edit. Never commit real secrets.

# Flask session-signing key. If unset, a random key is generated on every
# start (fine for this app: it keeps no user sessions).
SECRET_KEY=

# Port for `python app.py` (default 5000). PaaS hosts such as Render inject
# PORT themselves; the Docker image defaults to 10000.
PORT=5000

# Directory for generated PDF reports and per-scan state files. Defaults to the
# project root (./reports and ./logs). Point it at a persistent disk in production.
KAVALU_DATA_DIR=

# --- Optional external ML model plugin (disabled unless EXTERNAL_MODEL_URL is set)
# See docs/configuration.md for the request/response contract.
EXTERNAL_MODEL_URL=
EXTERNAL_MODEL_API_KEY=
# Seconds to wait for the model service (default 8).
EXTERNAL_MODEL_TIMEOUT=8
